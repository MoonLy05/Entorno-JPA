<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="jpa-practice-pu" transaction-type="RESOURCE_LOCAL">
        <class>com.dogocorp.jpa.model.Persona</class>
        <class>com.dogocorp.jpa.model.Usuario</class>
        <class>com.dogocorp.jpa.model.pagos.Pago</class>
        <class>com.dogocorp.jpa.model.pagos.PagoTarjeta</class>
        <class>com.dogocorp.jpa.model.pagos.PagoEfectivo</class>
        <class>com.dogocorp.jpa.model.pagos.DetallePago</class>
        <class>com.dogocorp.jpa.model.citas.Cita</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://bd.dogocorp.org:5432/project_db"/>
            
            <property name="jakarta.persistence.jdbc.user" value="admin_jpa"/>
            <property name="jakarta.persistence.jdbc.password" value="super_secret_password"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>